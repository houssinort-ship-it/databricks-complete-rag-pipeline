# ---------------------------------------------------------------------------
# Databricks connection (only for the Databricks adapters / notebook import)
# ---------------------------------------------------------------------------
# The Databricks SDK also reads DATABRICKS_CONFIG_PROFILE or a ~/.databrickscfg
# entry. Prefer a profile or a secret scope over hard-coded values.
# DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# ---------------------------------------------------------------------------
# Catalog objects (defaults reproduce the source notebook)
# ---------------------------------------------------------------------------
CATALOG=workspace
SCHEMA=default
VOLUME=rag_docs

# Local path used when running outside Databricks (ignored in the workspace).
# DOCS_PATH=data/pdfs

CHUNKS_TABLE=workspace.default.rag_chunks
INDEX_NAME=workspace.default.rag_chunks_index
VS_ENDPOINT_NAME=rag_endpoint

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
EMBEDDING_ENDPOINT=databricks-qwen3-embedding-0-6b
FALLBACK_EMBEDDING_ENDPOINT=databricks-gte-large-en
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Drop and rebuild the index (e.g. after changing embedding model)
RECREATE_INDEX=false

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
TOP_K=4
TEMPERATURE=0.1
MAX_TOKENS=800

# ---------------------------------------------------------------------------
# OPTIONAL local LLM (not part of the Databricks implementation)
# Any OpenAI-compatible server: Ollama, vLLM, llama.cpp, LM Studio.
# Leave empty to get an extractive answer (retrieved passages only).
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_API_KEY=
